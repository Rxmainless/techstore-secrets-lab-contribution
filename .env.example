# Modelo de configuração para execução local (npm start).
# Copie para .env e preencha os valores. Nunca versione o arquivo .env.
#
# No Docker Compose, os segredos não vêm deste arquivo: são lidos de arquivos
# em secrets/ (gerados por scripts/generate-secrets.sh), indicados pelas
# variáveis terminadas em _FILE. Exemplo: DB_PASSWORD_FILE=/run/secrets/db_password

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=techstore
DB_USER=techstore_app
DB_PASSWORD=

PAYMENT_API_KEY=
INTERNAL_API_TOKEN=
BACKUP_API_KEY=
